rules_version = '2';

// 프로필 사진 외에는 Storage를 쓰지 않음. 기본이 전면 거부이므로
// avatars/ 아래만 열어두고 나머지 경로는 규칙 자체를 두지 않음.
service firebase.storage {
  match /b/{bucket}/o {

    // 파일 이름이 곧 소유자 uid — avatars/{uid}.jpg 하나뿐이라
    // 사진을 바꾸면 항상 같은 자리를 덮어씀(옛 파일이 쌓이지 않음)
    match /avatars/{fileName} {
      function mine() {
        return request.auth != null && fileName == request.auth.uid + '.jpg';
      }

      // 친구·요청 목록에서 상대 아바타를 봐야 하므로 로그인한 사람은 모두 읽음.
      // (실제로는 getDownloadURL의 토큰이 붙은 주소로 내려받게 됨)
      allow read: if request.auth != null;

      // 업로드는 내 파일만. 앱이 512px로 줄여 올리므로 100KB 안쪽이지만,
      // 앱을 거치지 않는 호출까지 감안해 1MB·이미지로 상한을 둠
      // (image_picker가 원본 형식에 따라 png를 돌려줄 때가 있어 jpeg으로
      //  못 박지 않음 — 확장자는 항상 .jpg지만 실제 타입은 다를 수 있음)
      allow write: if mine() &&
        request.resource.size < 1 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');

      // 사진 삭제 / 회원탈퇴 시 정리 (write 규칙은 request.resource가 없어 못 씀)
      allow delete: if mine();
    }

    // 쿨다운의 '음성 한 마디'(§5-2). 경로에 uid가 들어가는 이유는
    // Storage 규칙이 Firestore를 못 읽어서다 — "이 러닝이 내 것인가"를
    // 물을 수 없으니 소유자를 경로에 박아야 판정할 수 있다.
    match /voices/{uid}/{fileName} {
      function mine() {
        return request.auth != null && request.auth.uid == uid;
      }

      // **아바타와 달리 남에게 열지 않는다.** 목소리는 얼굴보다 사적이고,
      // 남이 이 파일에 닿는 길은 러닝 문서에 실린 다운로드 주소뿐이다.
      // 그 문서는 Firestore 규칙이 공개 범위대로 지킨다
      allow read: if mine();

      // 20초 aacLc 모노면 200KB 안쪽이다. 앱을 거치지 않는 호출까지
      // 감안해 2MB로 막고, 오디오가 아닌 것은 받지 않는다
      allow write: if mine() &&
        request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');

      allow delete: if mine();
    }
  }
}
