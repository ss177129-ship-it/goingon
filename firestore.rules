rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (
          // friends 필드만 바뀌는 경우, 오직 "내 uid"만 추가/제거할 수 있음
          // (다른 사람의 친구 관계를 대신 조작하는 것은 막음)
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']) &&
          request.resource.data.friends.hasOnly(resource.data.friends.concat([request.auth.uid])) &&
          resource.data.friends.hasOnly(request.resource.data.friends.concat([request.auth.uid]))
        )
      );
    }

    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /sessions/{sessionId} {
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.hostId ||
        request.auth.uid == request.resource.data.guestId
      );
      allow read, update: if request.auth != null && (
        request.auth.uid == resource.data.hostId ||
        request.auth.uid == resource.data.guestId
      );
    }
  }
}
