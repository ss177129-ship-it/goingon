rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 요청 문서는 "대기 중"이라는 사실 자체를 나타냄 — 수락·거절·취소가 모두
    // 문서 삭제라서 상태 필드가 필요 없음. id를 "보낸사람_받는사람"으로 고정해
    // 같은 상대에게 요청이 두 번 생기는 걸 구조적으로 막음
    function pendingRequest(fromUid, toUid) {
      return exists(
        /databases/$(database)/documents/friendRequests/$(fromUid + '_' + toUid));
    }

    match /users/{userId} {
      allow get: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == userId;

      function friendsOnly() {
        return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['friends']);
      }
      function addedFriends() {
        return request.resource.data.friends
          .removeAll(resource.data.get('friends', []));
      }
      function removedFriends() {
        return resource.data.get('friends', [])
          .removeAll(request.resource.data.friends);
      }

      // 이름 변경
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);

      // 아이디(검색용 고유 핸들) 설정/변경
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username']);

      // 러닝 종료 시 통계 자동 갱신 (run_service._bumpMonthlyStats) —
      // createdAt은 여기 포함되지 않으므로 생성 이후 절대 못 바뀜
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['totalRuns', 'monthKm', 'monthKey', 'weekStreak', 'lastRunWeek']);

      // 푸시 기기 토큰 등록/해제 (push_service). 내 문서에만 쓸 수 있고,
      // 죽은 토큰 정리는 서버(Admin SDK)가 규칙을 우회해 처리함
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fcmTokens']) &&
        request.resource.data.fcmTokens is list &&
        request.resource.data.fcmTokens.size() <= 10;

      // ── 친구 연결은 '요청 → 수락'으로만 이뤄짐 ──
      // 예전에는 아이디만 알면 누구나 상대의 friends에 자기를 밀어넣을 수
      // 있었음(동의 없는 연결). 이제 양쪽 문서 모두 "나에게 온 대기 중 요청이
      // 실제로 존재할 때"만 친구 추가가 통과함. 수락 배치에서 요청 문서를 함께
      // 지우더라도 규칙은 배치 이전 상태를 보므로 exists()가 참임

      // 내 문서: 수락하면서 상대를 내 목록에 넣음 (요청은 상대→나 방향)
      allow update: if request.auth != null && request.auth.uid == userId &&
        friendsOnly() &&
        addedFriends().size() == 1 && removedFriends().size() == 0 &&
        pendingRequest(addedFriends()[0], userId);

      // 상대 문서: 내가 보낸 요청을 상대가 수락할 때, 상대 목록에 내 uid만 추가
      allow update: if request.auth != null && userId != request.auth.uid &&
        friendsOnly() &&
        addedFriends().size() == 1 &&
        addedFriends().hasOnly([request.auth.uid]) &&
        removedFriends().size() == 0 &&
        pendingRequest(userId, request.auth.uid);

      // 내 문서: 친구 제거 — 한 번에 최대 1명 (연결 끊기 / 차단 / 상대 탈퇴)
      allow update: if request.auth != null && request.auth.uid == userId &&
        friendsOnly() &&
        addedFriends().size() == 0 && removedFriends().size() <= 1;

      // 상대 문서: 내 uid만 제거 (내가 끊거나 차단할 때 상대 목록에서도 빠짐)
      allow update: if request.auth != null && userId != request.auth.uid &&
        friendsOnly() &&
        addedFriends().size() == 0 &&
        removedFriends().hasOnly([request.auth.uid]);

      // 내 문서: 차단/차단 해제. 차단은 친구 관계를 동시에 끊어야 하므로
      // friends가 같이 줄어드는 것을 허용함 (늘어나는 건 불가)
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['blocked', 'friends']) &&
        request.resource.data.blocked is list &&
        request.resource.data.blocked.size() <=
          resource.data.get('blocked', []).size() + 1 &&
        request.resource.data.get('friends', [])
          .hasOnly(resource.data.get('friends', []));
    }

    // 아이디 검색용 예약 문서 — 정확히 일치하는 문서 하나만 get 가능,
    // 컬렉션 전체 list는 막혀 있어 아이디 스캐닝 불가
    match /usernames/{username} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 친구 요청 — 문서 id는 "보낸사람uid_받는사람uid"로 고정.
    // 존재 = 대기 중. 수락·거절·취소는 전부 삭제로 처리하므로 status 필드가 없고,
    // 받은 요청 조회는 toUid 단일 조건이라 복합 인덱스도 필요 없음
    match /friendRequests/{requestId} {
      // 상대가 나를 차단했으면 요청 자체를 보낼 수 없음
      function blockedByRecipient(toUid) {
        return request.auth.uid in
          get(/databases/$(database)/documents/users/$(toUid)).data.get('blocked', []);
      }

      allow read: if request.auth != null && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.fromUid &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid != request.auth.uid &&
        requestId == request.resource.data.fromUid + '_' + request.resource.data.toUid &&
        request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'createdAt']) &&
        !blockedByRecipient(request.resource.data.toUid);

      // 수락·거절(받는 사람) / 취소(보낸 사람) 모두 삭제. 수정은 아예 없음
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
    }

    match /sessions/{sessionId} {
      function isParticipant() {
        return request.auth != null && (
          request.auth.uid == resource.data.hostId ||
          request.auth.uid == resource.data.guestId
        );
      }
      // 변경된 키 목록에 이 필드가 포함되는지
      function touched(field) {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
      }
      // {uid: 값} 형태의 맵에서 "내 uid 항목"만 건드렸는지
      // (상대의 준비 상태나 기록을 대신 쓰는 것을 차단)
      function onlyMyKey(before, after) {
        return after.diff(before).affectedKeys().hasOnly([request.auth.uid]);
      }

      // GO? 요청은 내가 호스트일 때만, 그리고 상대가 이미 내 친구일 때만 생성 가능
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.hostId &&
        request.resource.data.guestId is string &&
        request.resource.data.guestId != request.auth.uid &&
        request.resource.data.status == 'waiting' &&
        !('results' in request.resource.data) &&
        request.resource.data.guestId in
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.friends;

      allow read: if isParticipant();

      // 참가자라도 아무 필드나 못 바꿈. hostId/guestId/participants/createdAt은
      // 허용 목록에 없으므로 생성 이후 불변이고, {uid: 값} 맵은 자기 항목만 쓸 수 있음
      allow update: if isParticipant() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'ready', 'late', 'joined', 'gesture', 'results',
          'startedAt', 'declineMessage'
        ]) &&
        request.resource.data.status in
          ['waiting', 'ready', 'running', 'finished', 'cancelled'] &&
        (!touched('ready') ||
          onlyMyKey(resource.data.get('ready', {}), request.resource.data.ready)) &&
        (!touched('late') ||
          onlyMyKey(resource.data.get('late', {}), request.resource.data.late)) &&
        (!touched('joined') ||
          onlyMyKey(resource.data.get('joined', {}), request.resource.data.joined)) &&
        (!touched('results') ||
          onlyMyKey(resource.data.get('results', {}), request.resource.data.results)) &&
        (!touched('gesture') || request.resource.data.gesture.uid == request.auth.uid);
    }
  }
}
