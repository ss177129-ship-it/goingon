rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 요청 문서는 "대기 중"이라는 사실 자체를 나타냄 — 수락·거절·취소가 모두
    // 문서 삭제라서 상태 필드가 필요 없음. id를 "보낸사람_받는사람"으로 고정해
    // 같은 상대에게 요청이 두 번 생기는 걸 구조적으로 막음
    function pendingRequest(fromUid, toUid) {
      return exists(
        /databases/$(database)/documents/friendRequests/$(fromUid + '_' + toUid));
    }

    // 앱 설정 — 지금은 최소 빌드 번호 하나뿐.
    //
    // **로그인 전에도 읽어야 한다.** 낡은 빌드는 로그인 자체를 시켜서는 안
    // 되므로 인증 이전에 확인한다. 담기는 것은 공개해도 되는 숫자 하나이고,
    // 쓰기는 아무에게도 열지 않는다(콘솔이나 관리자 키로만 바꾼다)
    match /config/{document} {
      allow get: if true;
    }

    match /users/{userId} {
      allow get: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == userId;

      function friendsOnly() {
        return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['friends']);
      }
      function addedFriends() {
        return request.resource.data.friends
          .removeAll(resource.data.get('friends', []));
      }
      function removedFriends() {
        return resource.data.get('friends', [])
          .removeAll(request.resource.data.friends);
      }

      // 이름 변경
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);

      // 아이디(검색용 고유 핸들) 설정/변경
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username']);

      // 온보딩 레벨 — 홈의 기본값을 정하는 답 하나(RunnerLevel).
      // 값을 열거로 못박는 이유: 이 필드가 없으면 앱이 "온보딩 미완료"로
      // 보고 다시 온보딩에 태우므로, 엉뚱한 문자열이 들어가면 계정이
      // 온보딩과 홈 사이에 갇힌다
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['level']) &&
        request.resource.data.level in ['beginner', 'experienced'];

      // 프로필 사진 — 실제 이미지는 Storage(avatars/{uid}.jpg)에 있고 여기엔
      // 주소만 들어감. 사진을 지우면 필드 자체가 사라지므로(FieldValue.delete)
      // "photoUrl이 아예 없음"과 "문자열"만 유효한 상태임
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['photoUrl']) &&
        (!('photoUrl' in request.resource.data) ||
          request.resource.data.photoUrl is string);

      // 러닝 종료 시 통계 자동 갱신 (run_service._bumpMonthlyStats) —
      // createdAt은 여기 포함되지 않으므로 생성 이후 절대 못 바뀜
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['totalRuns', 'monthKm', 'monthKey', 'weekStreak', 'lastRunWeek']);

      // 푸시 기기 토큰 등록/해제 (push_service). 내 문서에만 쓸 수 있고,
      // 죽은 토큰 정리는 서버(Admin SDK)가 규칙을 우회해 처리함
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fcmTokens']) &&
        request.resource.data.fcmTokens is list &&
        request.resource.data.fcmTokens.size() <= 10;

      // ── 친구 연결은 '요청 → 수락'으로만 이뤄짐 ──
      // 예전에는 아이디만 알면 누구나 상대의 friends에 자기를 밀어넣을 수
      // 있었음(동의 없는 연결). 이제 양쪽 문서 모두 "나에게 온 대기 중 요청이
      // 실제로 존재할 때"만 친구 추가가 통과함. 수락 배치에서 요청 문서를 함께
      // 지우더라도 규칙은 배치 이전 상태를 보므로 exists()가 참임

      // 내 문서: 수락하면서 상대를 내 목록에 넣음 (요청은 상대→나 방향)
      allow update: if request.auth != null && request.auth.uid == userId &&
        friendsOnly() &&
        addedFriends().size() == 1 && removedFriends().size() == 0 &&
        pendingRequest(addedFriends()[0], userId);

      // 상대 문서: 내가 보낸 요청을 상대가 수락할 때, 상대 목록에 내 uid만 추가
      allow update: if request.auth != null && userId != request.auth.uid &&
        friendsOnly() &&
        addedFriends().size() == 1 &&
        addedFriends().hasOnly([request.auth.uid]) &&
        removedFriends().size() == 0 &&
        pendingRequest(userId, request.auth.uid);

      // 내 문서: 친구 제거 — 한 번에 최대 1명 (연결 끊기 / 차단 / 상대 탈퇴)
      allow update: if request.auth != null && request.auth.uid == userId &&
        friendsOnly() &&
        addedFriends().size() == 0 && removedFriends().size() <= 1;

      // 상대 문서: 내 uid만 제거 (내가 끊거나 차단할 때 상대 목록에서도 빠짐)
      allow update: if request.auth != null && userId != request.auth.uid &&
        friendsOnly() &&
        addedFriends().size() == 0 &&
        removedFriends().hasOnly([request.auth.uid]);

      // 내 문서: 차단/차단 해제. 차단은 친구 관계를 동시에 끊어야 하므로
      // friends가 같이 줄어드는 것을 허용함 (늘어나는 건 불가)
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['blocked', 'friends']) &&
        request.resource.data.blocked is list &&
        request.resource.data.blocked.size() <=
          resource.data.get('blocked', []).size() + 1 &&
        request.resource.data.get('friends', [])
          .hasOnly(resource.data.get('friends', []));
    }

    // 아이디 검색용 예약 문서 — 정확히 일치하는 문서 하나만 get 가능,
    // 컬렉션 전체 list는 막혀 있어 아이디 스캐닝 불가
    match /usernames/{username} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 친구 요청 — 문서 id는 "보낸사람uid_받는사람uid"로 고정.
    // 존재 = 대기 중. 수락·거절·취소는 전부 삭제로 처리하므로 status 필드가 없고,
    // 받은 요청 조회는 toUid 단일 조건이라 복합 인덱스도 필요 없음
    match /friendRequests/{requestId} {
      // 상대가 나를 차단했으면 요청 자체를 보낼 수 없음
      function blockedByRecipient(toUid) {
        return request.auth.uid in
          get(/databases/$(database)/documents/users/$(toUid)).data.get('blocked', []);
      }

      // 단건 조회는 **문서 데이터가 아니라 문서 id로** 판정한다.
      //
      // 왜: id가 "보낸사람_받는사람"이라 없는 문서를 읽는 것이 곧 "요청이
      // 없다"를 확인하는 정상 동작인데, resource.data를 보는 규칙은 문서가
      // 없으면 null을 참조해 **권한 거부**가 난다. 그래서 아직 아무 사이도
      // 아닌 사람을 검색할 때마다 친구 찾기가 통째로 실패했다(2026-08-16).
      // 배치 delete에서 겪은 것과 같은 함정이다.
      //
      // 느슨해진 것은 아니다: id에 내 uid가 들어간 쌍만 볼 수 있으므로
      // 남의 요청 관계를 캐는 것은 여전히 불가능하다
      function involvesMe(requestId) {
        return requestId.split('_').hasAny([request.auth.uid]);
      }
      allow get: if request.auth != null && involvesMe(requestId);

      // 목록 조회(나에게 온 요청)는 문서가 실제로 있으므로 데이터로 판정
      allow list: if request.auth != null && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.fromUid &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid != request.auth.uid &&
        requestId == request.resource.data.fromUid + '_' + request.resource.data.toUid &&
        request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'createdAt']) &&
        !blockedByRecipient(request.resource.data.toUid);

      // 수락·거절(받는 사람) / 취소(보낸 사람) 모두 삭제. 수정은 아예 없음
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
    }

    match /sessions/{sessionId} {
      function isParticipant() {
        return request.auth != null && (
          request.auth.uid == resource.data.hostId ||
          request.auth.uid == resource.data.guestId
        );
      }
      // 변경된 키 목록에 이 필드가 포함되는지
      function touched(field) {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
      }
      // {uid: 값} 형태의 맵에서 "내 uid 항목"만 건드렸는지
      // (상대의 준비 상태나 기록을 대신 쓰는 것을 차단)
      function onlyMyKey(before, after) {
        return after.diff(before).affectedKeys().hasOnly([request.auth.uid]);
      }

      // GO? 요청은 내가 호스트일 때만, 그리고 상대가 이미 내 친구일 때만 생성 가능
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.hostId &&
        request.resource.data.guestId is string &&
        request.resource.data.guestId != request.auth.uid &&
        request.resource.data.status == 'waiting' &&
        !('results' in request.resource.data) &&
        request.resource.data.guestId in
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.friends;

      allow read: if isParticipant();

      // 참가자라도 아무 필드나 못 바꿈. hostId/guestId/participants/createdAt은
      // 허용 목록에 없으므로 생성 이후 불변이고, {uid: 값} 맵은 자기 항목만 쓸 수 있음
      allow update: if isParticipant() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'ready', 'late', 'joined', 'gesture', 'results',
          'startedAt', 'declineMessage', 'live'
        ]) &&
        request.resource.data.status in
          ['waiting', 'ready', 'running', 'finished', 'cancelled'] &&
        (!touched('ready') ||
          onlyMyKey(resource.data.get('ready', {}), request.resource.data.ready)) &&
        (!touched('late') ||
          onlyMyKey(resource.data.get('late', {}), request.resource.data.late)) &&
        (!touched('joined') ||
          onlyMyKey(resource.data.get('joined', {}), request.resource.data.joined)) &&
        (!touched('results') ||
          onlyMyKey(resource.data.get('results', {}), request.resource.data.results)) &&
        (!touched('gesture') || request.resource.data.gesture.uid == request.auth.uid) &&
        // 러닝 중 실시간 상태(케이던스·페이스·거리). results와 같은 규칙 —
        // 남의 칸에 쓰면 상대가 달리지도 않은 것을 달린 것처럼 만들 수 있다
        (!touched('live') ||
          onlyMyKey(resource.data.get('live', {}), request.resource.data.live));
    }

    // ── 고스트 (2026-08-23 P4) ──────────────────────────────────────
    //
    // 모든 러닝이 고스트가 된다(§3-2). 남의 그날과 달릴 수 있으려면 읽기가
    // 열려야 하는데, **얼마나 열리는지는 주인이 정한다.** 기본은
    // 페이스메이트만 — 1차 세그먼트는 기록 공개가 부담스러운 사람들이라
    // 공개가 기본이면 첫 러닝을 아예 남기지 않는다.
    match /runs/{runId} {
      function mine() {
        return request.auth != null && request.auth.uid == resource.data.uid;
      }
      // 서로 친구인가 — 한쪽 목록만 보면 상대가 나를 지운 뒤에도 계속 읽힌다
      function pacemates() {
        return request.auth != null &&
          request.auth.uid in
            get(/databases/$(database)/documents/users/$(resource.data.uid))
              .data.get('friends', []);
      }

      allow get: if mine() ||
        resource.data.get('visibility', 'pacemates') == 'everyone' ||
        (resource.data.get('visibility', 'pacemates') == 'pacemates' && pacemates());

      /// 내 친구 목록. **상대의 목록이 아니라 내 목록을 보는 이유**는
      /// 호출 비용이다 — 목록 쿼리는 돌아오는 문서마다 규칙이 돌고,
      /// 상대 문서를 읽으면 사람 수만큼 get()이 생겨 한도(10)를 넘긴다.
      /// 내 문서는 어느 문서를 판정하든 같은 경로라 한 번만 읽힌다.
      /// 연결 끊기는 양쪽 문서를 한 배치로 지우므로(friend_service)
      /// 내 목록과 상대 목록은 같은 것을 말한다
      function myFriends() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('friends', []);
      }

      // 목록 조회도 문서 단위로 판정한다. 예전에는 로그인만 확인하고
      // "클라이언트가 uid를 좁혀 던진다"를 전제로 뒀는데, 규칙이 강제하지
      // 않는 전제는 전제일 뿐이라 아무나 runs 전체를 훑을 수 있었다.
      //
      // 돌아오는 문서 중 **하나라도** 이 조건을 못 넘기면 쿼리 전체가
      // 거부된다. 그래서 클라이언트는 페이스메이트 조회에서 private을
      // 애초에 빼고 던진다(ghost_service.recentFrom)
      allow list: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        resource.data.get('visibility', 'pacemates') == 'everyone' ||
        (resource.data.get('visibility', 'pacemates') == 'pacemates' &&
          resource.data.uid in myFriends())
      );

      // 남길 때 자기 것으로만. uid를 남의 것으로 적으면 그 사람의 여정에
      // 내가 달린 기록이 섞인다
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;

      // 나중에 바꿀 수 있는 것은 공개 범위와 사연 한 마디뿐이다.
      // 거리·시간·케이던스는 **남긴 뒤 불변** — 고친 기록으로 남과 달리면
      // 그건 그날의 리듬이 아니다
      allow update: if mine() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['visibility', 'story']);

      allow delete: if mine();

      // 함께 달렸다는 기록. 서버가 이것을 보고 알림을 보낸다(발송은 서버만).
      // 쓰는 사람은 '함께 달린 나'이고, 문서 id가 내 uid라 한 사람이 같은
      // 고스트에 여러 번 쌓을 수 없다
      match /companions/{companionUid} {
        allow read: if request.auth != null &&
          (request.auth.uid == companionUid ||
            request.auth.uid ==
              get(/databases/$(database)/documents/runs/$(runId)).data.uid);
        allow create, update: if request.auth != null &&
          request.auth.uid == companionUid &&
          request.resource.data.companionUid == request.auth.uid;
      }
    }
  }
}
