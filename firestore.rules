rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 요청 문서는 "대기 중"이라는 사실 자체를 나타냄 — 수락·거절·취소가 모두
    // 문서 삭제라서 상태 필드가 필요 없음. id를 "보낸사람_받는사람"으로 고정해
    // 같은 상대에게 요청이 두 번 생기는 걸 구조적으로 막음
    function pendingRequest(fromUid, toUid) {
      return exists(
        /databases/$(database)/documents/friendRequests/$(fromUid + '_' + toUid));
    }

    // 앱 설정 — 지금은 최소 빌드 번호 하나뿐.
    //
    // **로그인 전에도 읽어야 한다.** 낡은 빌드는 로그인 자체를 시켜서는 안
    // 되므로 인증 이전에 확인한다. 담기는 것은 공개해도 되는 숫자 하나이고,
    // 쓰기는 아무에게도 열지 않는다(콘솔이나 관리자 키로만 바꾼다)
    match /config/{document} {
      allow get: if true;
    }

    match /users/{userId} {
      allow get: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == userId;

      // ── 관계 배열 (contract 완료: following 하나만) ──
      //
      // `follows/{follower}_{followee}`가 진실의 원천이고, 이 배열은
      // **규칙이 쓰려고 두는 투영**이다. 목록 규칙이 `exists(follows/...)`를
      // 쓰면 평가하는 문서마다 경로가 달라져 접근 한도(10)를 넘긴다.
      // 내 문서 하나를 읽는 배열 방식은 몇 명이든 한 번으로 끝난다.
      //
      // 옛 `friends`는 더 이상 쓸 수 없다. 남아 있는 값은 아무도 읽지 않고,
      // 쓰기는 여기서 막힌다 — 되살아나는 길을 닫아 둔다
      function relationOnly() {
        return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['following']);
      }
      function added() {
        return request.resource.data.get('following', [])
          .removeAll(resource.data.get('following', []));
      }
      function removed() {
        return resource.data.get('following', [])
          .removeAll(request.resource.data.get('following', []));
      }

      // 이름 변경
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);

      // 아이디(검색용 고유 핸들) 설정/변경
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username']);

      // 온보딩 레벨 — 홈의 기본값을 정하는 답 하나(RunnerLevel).
      // 값을 열거로 못박는 이유: 이 필드가 없으면 앱이 "온보딩 미완료"로
      // 보고 다시 온보딩에 태우므로, 엉뚱한 문자열이 들어가면 계정이
      // 온보딩과 홈 사이에 갇힌다
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['level']) &&
        request.resource.data.level in ['beginner', 'experienced'];

      // 프로필 사진 — 실제 이미지는 Storage(avatars/{uid}.jpg)에 있고 여기엔
      // 주소만 들어감. 사진을 지우면 필드 자체가 사라지므로(FieldValue.delete)
      // "photoUrl이 아예 없음"과 "문자열"만 유효한 상태임
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['photoUrl']) &&
        (!('photoUrl' in request.resource.data) ||
          request.resource.data.photoUrl is string);

      // 러닝 종료 시 통계 자동 갱신 (run_service._bumpMonthlyStats) —
      // createdAt은 여기 포함되지 않으므로 생성 이후 절대 못 바뀜
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['totalRuns', 'monthKm', 'monthKey', 'weekStreak',
                    'lastRunWeek', 'totalKm']);

      // 푸시 기기 토큰 등록/해제 (push_service). 내 문서에만 쓸 수 있고,
      // 죽은 토큰 정리는 서버(Admin SDK)가 규칙을 우회해 처리함
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fcmTokens']) &&
        request.resource.data.fcmTokens is list &&
        request.resource.data.fcmTokens.size() <= 10;

      // ── 친구 연결은 '요청 → 수락'으로만 이뤄짐 ──
      // 예전에는 아이디만 알면 누구나 상대의 friends에 자기를 밀어넣을 수
      // 있었음(동의 없는 연결). 이제 양쪽 문서 모두 "나에게 온 대기 중 요청이
      // 실제로 존재할 때"만 친구 추가가 통과함. 수락 배치에서 요청 문서를 함께
      // 지우더라도 규칙은 배치 이전 상태를 보므로 exists()가 참임

      // 내 문서: 수락하면서 상대를 내 목록에 넣음 (요청은 상대→나 방향)
      allow update: if request.auth != null && request.auth.uid == userId &&
        relationOnly() &&
        added().size() == 1 && removed().size() == 0 &&
        pendingRequest(added()[0], userId);

      // 상대 문서: 내가 보낸 요청을 상대가 수락할 때, 상대 목록에 내 uid만 추가
      allow update: if request.auth != null && userId != request.auth.uid &&
        relationOnly() &&
        added().hasOnly([request.auth.uid]) && added().size() == 1 &&
        removed().size() == 0 &&
        pendingRequest(userId, request.auth.uid);

      // 내 문서: 관계 제거 — 한 번에 최대 1명 (연결 끊기 / 차단 / 상대 탈퇴)
      allow update: if request.auth != null && request.auth.uid == userId &&
        relationOnly() && added().size() == 0 && removed().size() <= 1;

      // 상대 문서: 내 uid만 제거 (내가 끊거나 차단할 때 상대 목록에서도 빠짐)
      allow update: if request.auth != null && userId != request.auth.uid &&
        relationOnly() &&
        added().size() == 0 && removed().hasOnly([request.auth.uid]);

      // 내 문서: 차단/차단 해제. 차단은 관계를 동시에 끊어야 하므로
      // following이 같이 줄어드는 것을 허용함 (늘어나는 건 불가)
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['blocked', 'following']) &&
        request.resource.data.blocked is list &&
        request.resource.data.blocked.size() <=
          resource.data.get('blocked', []).size() + 1 &&
        request.resource.data.get('following', [])
          .hasOnly(resource.data.get('following', []));
    }

    // 페이스메이트 간선 — **진실의 원천**(P6.5).
    //
    // 구조가 비대칭인 이유는 v1.1의 게이트형 DM이 '맞팔' 위에 설계돼 있기
    // 때문이다. v1.0의 UI는 단일 상태(맺어졌거나 아니거나)라 수락 시 두
    // 간선이 함께 생기지만, 나중에 한쪽만 남는 상태를 표현할 수 있어야
    // 그때 다시 이관하지 않는다.
    //
    // id가 "팔로워_팔로위"로 고정이라 같은 간선이 두 번 생기지 않는다.
    match /follows/{edgeId} {
      function follower() { return request.resource.data.followerUid; }
      function followee() { return request.resource.data.followeeUid; }

      // **생성은 대기 중 요청이 있을 때만.** 검색이 열려 있는 동안 수락이
      // 유일한 프라이버시 장치다 — 승인 없이 간선을 만들 수 있으면 아이디를
      // 아는 사람이 곧 남의 고스트를 볼 수 있는 사람이 된다
      allow create: if request.auth != null &&
        edgeId == follower() + '_' + followee() &&
        follower() != followee() &&
        (
          // 내가 수락하는 쪽: 상대→나 간선을 내가 만든다
          (request.auth.uid == followee() &&
            pendingRequest(follower(), request.auth.uid)) ||
          // 같은 수락에서 나→상대 간선도 함께 만든다
          (request.auth.uid == follower() &&
            pendingRequest(followee(), request.auth.uid))
        );

      // 내가 낀 간선만 보인다. 남의 관계를 캐는 것은 불가능하다
      allow get, list: if request.auth != null &&
        (resource.data.followerUid == request.auth.uid ||
          resource.data.followeeUid == request.auth.uid);

      // 간선은 있거나 없다 — 고쳐 쓰지 않는다
      allow update: if false;

      allow delete: if request.auth != null &&
        (resource.data.followerUid == request.auth.uid ||
          resource.data.followeeUid == request.auth.uid);
    }

    // 아이디 검색용 예약 문서 — 정확히 일치하는 문서 하나만 get 가능,
    // 컬렉션 전체 list는 막혀 있어 아이디 스캐닝 불가
    match /usernames/{username} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 친구 요청 — 문서 id는 "보낸사람uid_받는사람uid"로 고정.
    // 존재 = 대기 중. 수락·거절·취소는 전부 삭제로 처리하므로 status 필드가 없고,
    // 받은 요청 조회는 toUid 단일 조건이라 복합 인덱스도 필요 없음
    match /friendRequests/{requestId} {
      // 상대가 나를 차단했으면 요청 자체를 보낼 수 없음
      function blockedByRecipient(toUid) {
        return request.auth.uid in
          get(/databases/$(database)/documents/users/$(toUid)).data.get('blocked', []);
      }

      // 단건 조회는 **문서 데이터가 아니라 문서 id로** 판정한다.
      //
      // 왜: id가 "보낸사람_받는사람"이라 없는 문서를 읽는 것이 곧 "요청이
      // 없다"를 확인하는 정상 동작인데, resource.data를 보는 규칙은 문서가
      // 없으면 null을 참조해 **권한 거부**가 난다. 그래서 아직 아무 사이도
      // 아닌 사람을 검색할 때마다 친구 찾기가 통째로 실패했다(2026-08-16).
      // 배치 delete에서 겪은 것과 같은 함정이다.
      //
      // 느슨해진 것은 아니다: id에 내 uid가 들어간 쌍만 볼 수 있으므로
      // 남의 요청 관계를 캐는 것은 여전히 불가능하다
      function involvesMe(requestId) {
        return requestId.split('_').hasAny([request.auth.uid]);
      }
      allow get: if request.auth != null && involvesMe(requestId);

      // 목록 조회(나에게 온 요청)는 문서가 실제로 있으므로 데이터로 판정
      allow list: if request.auth != null && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.fromUid &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid != request.auth.uid &&
        requestId == request.resource.data.fromUid + '_' + request.resource.data.toUid &&
        request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'createdAt']) &&
        !blockedByRecipient(request.resource.data.toUid);

      // 수락·거절(받는 사람) / 취소(보낸 사람) 모두 삭제. 수정은 아예 없음
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
    }

    match /sessions/{sessionId} {
      function isParticipant() {
        return request.auth != null && (
          request.auth.uid == resource.data.hostId ||
          request.auth.uid == resource.data.guestId
        );
      }
      // 변경된 키 목록에 이 필드가 포함되는지
      function touched(field) {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
      }
      // {uid: 값} 형태의 맵에서 "내 uid 항목"만 건드렸는지
      // (상대의 준비 상태나 기록을 대신 쓰는 것을 차단)
      function onlyMyKey(before, after) {
        return after.diff(before).affectedKeys().hasOnly([request.auth.uid]);
      }

      // GO? 요청은 내가 호스트일 때만, 그리고 상대가 이미 내 친구일 때만 생성 가능
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.hostId &&
        request.resource.data.guestId is string &&
        request.resource.data.guestId != request.auth.uid &&
        request.resource.data.status == 'waiting' &&
        !('results' in request.resource.data) &&
        request.resource.data.guestId in
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.friends;

      allow read: if isParticipant();

      // 참가자라도 아무 필드나 못 바꿈. hostId/guestId/participants/createdAt은
      // 허용 목록에 없으므로 생성 이후 불변이고, {uid: 값} 맵은 자기 항목만 쓸 수 있음
      allow update: if isParticipant() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'ready', 'late', 'joined', 'gesture', 'results',
          'startedAt', 'declineMessage', 'live'
        ]) &&
        request.resource.data.status in
          ['waiting', 'ready', 'running', 'finished', 'cancelled'] &&
        (!touched('ready') ||
          onlyMyKey(resource.data.get('ready', {}), request.resource.data.ready)) &&
        (!touched('late') ||
          onlyMyKey(resource.data.get('late', {}), request.resource.data.late)) &&
        (!touched('joined') ||
          onlyMyKey(resource.data.get('joined', {}), request.resource.data.joined)) &&
        (!touched('results') ||
          onlyMyKey(resource.data.get('results', {}), request.resource.data.results)) &&
        (!touched('gesture') || request.resource.data.gesture.uid == request.auth.uid) &&
        // 러닝 중 실시간 상태(케이던스·페이스·거리). results와 같은 규칙 —
        // 남의 칸에 쓰면 상대가 달리지도 않은 것을 달린 것처럼 만들 수 있다
        (!touched('live') ||
          onlyMyKey(resource.data.get('live', {}), request.resource.data.live));
    }

    // ── 고스트 (2026-08-23 P4) ──────────────────────────────────────
    //
    // 모든 러닝이 고스트가 된다(§3-2). 남의 그날과 달릴 수 있으려면 읽기가
    // 열려야 하는데, **얼마나 열리는지는 주인이 정한다.** 기본은
    // 페이스메이트만 — 1차 세그먼트는 기록 공개가 부담스러운 사람들이라
    // 공개가 기본이면 첫 러닝을 아예 남기지 않는다.
    // 응원 — **도착은 오늘, 재생은 다음 러닝의 출발선**(§5-4).
    // 상태가 있는 이유가 그것이고, 상태를 누가 바꿀 수 있는지가 곧
    // "누가 들었다고 말할 수 있는가"다
    match /cheers/{cheerId} {
      allow create: if request.auth != null &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.status == 'queued';

      allow read: if request.auth != null &&
        (resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid);

      // **받은 사람만** 들었다고 표시한다. 보낸 사람이 바꿀 수 있으면
      // 재생되지도 않은 응원을 재생된 것으로 만들 수 있고, 그러면 상대의
      // 출발선에서 그 응원은 영영 안 들린다
      allow update: if request.auth != null &&
        resource.data.toUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status']) &&
        request.resource.data.status == 'bridged';

      // 보낸 응원은 지울 수 없다. 취소는 상대가 이미 예고 푸시를 받은
      // 뒤라 취소가 아니라 혼란이다
      allow delete: if false;
    }

    match /runs/{runId} {
      function mine() {
        return request.auth != null && request.auth.uid == resource.data.uid;
      }
      // 이 사람이 나를 팔로우하는가 — 즉 내가 이 사람의 러닝을 볼 수 있게
      // 허락된 관계인가. 단일 문서 조회라 상대 문서를 읽어도 get()이 하나다
      function pacemates() {
        return request.auth != null &&
          request.auth.uid in
            get(/databases/$(database)/documents/users/$(resource.data.uid))
              .data.get('following', []);
      }

      allow get: if mine() ||
        resource.data.get('visibility', 'pacemates') == 'everyone' ||
        (resource.data.get('visibility', 'pacemates') == 'pacemates' && pacemates());

      /// 내가 팔로우하는 사람들. **상대의 목록이 아니라 내 목록을 보는
      /// 이유**는 호출 비용이다 — 목록 쿼리는 돌아오는 문서마다 규칙이 돌고,
      /// 상대 문서를 읽으면 사람 수만큼 get()이 생겨 한도(10)를 넘긴다.
      /// 내 문서는 어느 문서를 판정하든 같은 경로라 한 번만 읽힌다.
      ///
      /// 이 배열에 사람이 들어가는 길은 **수락뿐**이므로(위 users 규칙),
      /// 여기서 읽는 것이 곧 "상대가 허락한 관계"다
      function myFollowing() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('following', []);
      }

      // 목록 조회에서 `resource.data`는 **문서 내용이 아니라 쿼리 조건**으로
      // 채워진다(2026-08-23 에뮬레이터로 확인). 즉 여기 쓰는 필드는 전부
      // 클라이언트가 where로 좁혀야 하고, 안 좁히면 조건이 성립하지 않아
      // 쿼리 전체가 거부된다.
      //
      // **`.get(필드, 기본값)`을 쓰면 안 된다.** 기본값이 있으면 클라이언트가
      // 그 필드를 안 좁혔을 때 기본값으로 판정이 통과해 버린다. 실제로
      // `.get('visibility','pacemates')`로 뒀다가, 공개 범위를 안 걸고 던진
      // 쿼리에서 **페이스메이트의 private 런이 그대로 나왔다.**
      // 그래서 여기서는 필드를 직접 읽는다 — 안 좁히면 거부가 정답이다.
      allow list: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        resource.data.visibility == 'everyone' ||
        (resource.data.visibility == 'pacemates' &&
          resource.data.uid in myFollowing())
      );

      // 남길 때 자기 것으로만. uid를 남의 것으로 적으면 그 사람의 여정에
      // 내가 달린 기록이 섞인다
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;

      // 나중에 바꿀 수 있는 것은 공개 범위와 사연뿐이다(글 한 줄, 목소리
      // 한 마디). 거리·시간·케이던스는 **남긴 뒤 불변** — 고친 기록으로
      // 남과 달리면 그건 그날의 리듬이 아니다.
      //
      // storyClipUrl이 여기 있는 이유: 음성은 러닝이 끝나고 쿨다운에서
      // 채집되므로 문서가 이미 저장된 뒤에 붙는다(§5-2)
      allow update: if mine() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['visibility', 'story', 'storyClipUrl']);

      allow delete: if mine();

      // 함께 달렸다는 기록. 서버가 이것을 보고 알림을 보낸다(발송은 서버만).
      // 쓰는 사람은 '함께 달린 나'이고, 문서 id가 내 uid라 한 사람이 같은
      // 고스트에 여러 번 쌓을 수 없다
      match /companions/{companionUid} {
        allow read: if request.auth != null &&
          (request.auth.uid == companionUid ||
            request.auth.uid ==
              get(/databases/$(database)/documents/runs/$(runId)).data.uid);
        allow create, update: if request.auth != null &&
          request.auth.uid == companionUid &&
          request.resource.data.companionUid == request.auth.uid;
      }
    }
  }
}
